# Server
PORT=4174
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:4174
ISCHEDULE_DATA_DIR=./server/data

# Set this in production behind HTTPS. The application uses secure cookies when
# PUBLIC_ORIGIN starts with https://.
NODE_ENV=development

# Optional outbound mail configuration. Without these values, password reset
# and invitation links are written to the server log for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
